{
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-10-30T00:00:00+07:00",
  "name": "Valheim",
  "author": "GarudaPanel",
  "description": "Valheim dedicated server.",
  "features": null,
  "docker_images": {
    "Valheim": "ghcr.io/parkervcp/yolks:valheim"
  },
  "file_denylist": [],
  "startup": "./valheim_server.x86_64 -name \"{{SERVER_NAME}}\" -port {{SERVER_PORT}} -world \"{{WORLD_NAME}}\" -password \"{{SERVER_PASSWORD}}\" -public 1",
  "config": {
    "files": "{}",
    "startup": {
      "done": "Game server connected",
      "user_interaction": []
    },
    "logs": {
      "custom": false,
      "location": "logs/latest.log"
    },
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\ncd /mnt/server\nsteamcmd +force_install_dir /mnt/server +login anonymous +app_update 896660 validate +quit\n",
      "container": "ghcr.io/parkervcp/installers:debian",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Server Name",
      "description": "Nama server di browser.",
      "env_variable": "SERVER_NAME",
      "default_value": "Garuda Valheim",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    },
    {
      "name": "World Name",
      "description": "Nama world.",
      "env_variable": "WORLD_NAME",
      "default_value": "Dedicated",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    },
    {
      "name": "Server Password",
      "description": "Password join (min 5 karakter).",
      "env_variable": "SERVER_PASSWORD",
      "default_value": "garuda123",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    }
  ]
}
