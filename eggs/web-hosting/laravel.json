      "container": "ghcr.io/parkervcp/installers:debian",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Requirements",
      "description": "Jalankan composer install saat install.",
      "env_variable": "COMPOSER_INSTALL",
