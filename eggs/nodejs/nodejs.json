{
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-10-30T00:00:00+07:00",
  "name": "Node.js",
  "author": "GarudaPanel",
  "description": "Aplikasi Node.js generik (Express, Fastify, bot, API).",
  "features": null,
  "docker_images": {
    "Node.js 20": "ghcr.io/parkervcp/yolks:nodejs_20",
    "Node.js 22": "ghcr.io/parkervcp/yolks:nodejs_22"
  },
  "file_denylist": [],
  "startup": "{{CMD_RUN}}",
  "config": {
    "files": "{}",
    "startup": {
      "done": "",
      "user_interaction": []
    },
    "logs": {
      "custom": false,
      "location": "logs/latest.log"
    },
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\ncd /mnt/server\nif [ -n \"${GIT_ADDRESS}\" ]; then git clone --branch \"${BRANCH:-main}\" \"${GIT_ADDRESS}\" . 2>/dev/null || git pull; fi\n[ -f package.json ] && npm install --no-audit --no-fund\n",
      "container": "ghcr.io/parkervcp/installers:debian",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Run Command",
      "description": "Perintah jalanin app.",
      "env_variable": "CMD_RUN",
      "default_value": "npm start",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    },
    {
      "name": "Git Address",
      "description": "Repo git (kosong = upload manual).",
      "env_variable": "GIT_ADDRESS",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    },
    {
      "name": "Branch",
      "description": "Branch git.",
      "env_variable": "BRANCH",
      "default_value": "main",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    },
    {
      "name": "Username",
      "description": "Username git (repo privat).",
      "env_variable": "USERNAME",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    },
    {
      "name": "Access Token",
      "description": "Token git (repo privat).",
      "env_variable": "ACCESS_TOKEN",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:191"
    }
  ]
}
